# Non-secret stack settings (committed). Edit and re-run the up script.
# Secrets belong in .env (see .env.example).

# --- Ports (host and SmileCDR module config) ---
FHIR_PORT=8000
FHIRWEB_PORT=8001
ADMIN_JSON_PORT=9000
ADMIN_WEB_PORT=9100
SMART_AUTH_PORT=9200
SMART_DEMO_PORT=9201
POSTGRES_HOST_PORT=5432

# --- PostgreSQL ---
# Major version used when Docker Hub lookup fails. Prefer {major}-alpine.
POSTGRES_MAJOR=17
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# SmileCDR application database (created by init_postgresdb.sh)
DB_CDR_NAME=cdr
DB_CDR_USER=cdr
DB_CDR_PASSWORD=SmileCDR

# Compose platform for Releases-site AMD64 images. Override for ARM64 pulls.
SMILECDR_PLATFORM=linux/amd64
